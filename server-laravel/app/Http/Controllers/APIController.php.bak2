<?php

namespace App\Http\Controllers;

use App\Models\User;
use Illuminate\Http\Request;

class APIController extends Controller
{
    public function notifRead(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $user->update(['notif_read_at' => now()->timestamp]);

        return response()->json(['ok' => true]);
    }

    public function getTgLink(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        if (!in_array($user->role, ['sreq', 'schk'], true)) {
            return response()->json(['error' => 'role_not_allowed'], 403);
        }

        $code = bin2hex(random_bytes(8));
        $user->update(['tg_link_code' => $code]);

        $botUsername = env('TELEGRAM_BOT_USERNAME', '');
        $url = $botUsername ? "https://t.me/$botUsername?start=$code" : null;

        return response()->json([
            'code' => $code,
            'url' => $url,
            'linked' => !empty($user->telegram_chat_id)
        ]);
    }

    public function tgWebhook(Request $request)
    {
        // 텔레그램 웹훅 시크릿 검증
        $secret = env('TELEGRAM_WEBHOOK_SECRET');
        $token = $request->header('X-Telegram-Bot-Api-Secret-Token') ?? '';

        if ($secret && $token !== $secret) {
            return response()->json(['ok' => true]);
        }

        $msg = $request->input('message');
        if ($msg && isset($msg['text'])) {
            // /start 커맨드로 링크 코드 처리
            if (preg_match('/^\/start\s+([a-f0-9]{16})/', $msg['text'], $matches)) {
                $code = $matches[1];
                $user = User::where('tg_link_code', $code)->first();

                if ($user) {
                    $chatId = (string)($msg['chat']['id'] ?? '');
                    $user->update([
                        'telegram_chat_id' => $chatId,
                        'tg_link_code' => null
                    ]);

                    // 텔레그램 메시지 전송 (tgSend 함수는 필요시 구현)
                    // tgSend($chatId, "연결되었습니다!");
                }
            }
        }

        return response()->json(['ok' => true]);
    }

    public function cron(Request $request)
    {
        $key = $request->query('key');
        if ($key !== env('CRON_KEY', 'change-me')) {
            return response()->json(['error' => 'forbidden'], 403);
        }

        $job = $request->query('job') ?? '';
        // runDigest 함수 구현 필요
        $result = ['status' => 'ok', 'job' => $job];

        return response()->json($result);
    }

    public function cronPost(Request $request)
    {
        $key = $request->input('key');
        if ($key !== env('CRON_KEY', 'change-me')) {
            return response()->json(['error' => 'forbidden'], 403);
        }

        $job = $request->input('job') ?? '';
        $result = ['status' => 'ok', 'job' => $job];

        return response()->json($result);
    }
}
