<?php

namespace App\Http\Controllers;

use App\Models\User;
use App\Models\Request as RequestModel;
use App\Models\Notification;
use App\Models\Meta;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class AgentController extends Controller
{
    public function getAgents(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $agents = User::where('role', 'agent')
            ->where('status', 'approved')
            ->select('name', 'nickname')
            ->orderBy('name')
            ->get();

        return response()->json(['agents' => $agents]);
    }

    public function getState(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $rev = (int) Meta::where('key', 'rev')->value('value') ?? 0;
        $since = (int) ($request->query('rev') ?? -1);

        $response = ['rev' => $rev];

        if ($since !== $rev) {
            $response['requests'] = $this->getAllRequests($user);
            foreach ($response['requests'] as &$req) {
                if (isset($req['ws']) && is_array($req['ws']) && count($req['ws']) === 0) {
                    $req['ws'] = (object)[];
                }
            }
            unset($req);

            $phones = Meta::where('key', 'phones')->value('value');
            $response['phones'] = (object)($phones ? json_decode($phones, true) : []);
            $fullbook = Meta::where('key', 'fullbook')->value('value');
            $response['fullbook'] = (object)($fullbook ? json_decode($fullbook, true) : []);
            $response['seq'] = (int) Meta::where('key', 'seq')->value('value') ?? 0;
            $response['seqA'] = (int) Meta::where('key', 'seqA')->value('value') ?? 0;
            $response['seqD'] = (int) Meta::where('key', 'seqD')->value('value') ?? 0;
        }

        $notifications = Notification::where('role', $user->role)
            ->where(function ($query) use ($user) {
                $query->whereNull('exclude_user')
                    ->orWhere('exclude_user', '!=', $user->id);
            })
            ->orderByDesc('id')
            ->limit(20)
            ->get();

        $items = [];
        $unread = 0;
        foreach ($notifications as $notif) {
            $item = [
                'type' => $notif->type,
                'no' => $notif->req_no,
                'p' => json_decode($notif->params ?? '{}', true),
                'at' => (int) $notif->created_at
            ];
            if ((int) $notif->created_at > (int) ($user->notif_read_at ?? 0)) {
                $item['new'] = true;
                $unread++;
            }
            $items[] = $item;
        }
        $response['notifs'] = ['unread' => $unread, 'items' => $items];

        return response()->json($response);
    }

    public function sync(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $fixes = [];
        $changed = false;

        foreach (($request->input('requests') ?? []) as $req) {
            if (!is_array($req) || empty($req['id'])) continue;

            $id = (int) $req['id'];
            $requestModel = RequestModel::where('id', $id)->where('deleted', 0)->first();
            $old = $requestModel ? json_decode($requestModel->payload, true) : null;

            if ($old === null) {
                $seqKey = !empty($req['direct']) ? 'seqD' : 'seqA';
                $seq = (int) (Meta::where('key', $seqKey)->value('value') ?? 0) + 1;
                Meta::updateOrCreate(['key' => $seqKey], ['value' => (string)$seq]);

                if (empty($req['no']) || $req['no'] != $seq) {
                    $req['no'] = $seq;
                    $fixes[] = ['id' => $id, 'no' => $seq];
                }

                RequestModel::create([
                    'id' => $id,
                    'no' => (int) $req['no'],
                    'payload' => json_encode($req, JSON_UNESCAPED_UNICODE),
                    'deleted' => 0,
                    'created_by' => $user->id,
                    'updated_at' => now()->timestamp,
                    'updated_by' => $user->id,
                ]);
            } else {
                DB::statement("SELECT GET_LOCK(?, 5)", ["rc_" . $id]);
                try {
                    $requestModel = RequestModel::where('id', $id)->where('deleted', 0)->first();
                    $cur = $requestModel ? json_decode($requestModel->payload, true) : $old;
                    $curWs = (is_array($cur) && isset($cur['ws']) && is_array($cur['ws'])) ? $cur['ws'] : [];
                    $newWs = (isset($req['ws']) && is_array($req['ws'])) ? $req['ws'] : [];

                    $merged = [];
                    foreach ($newWs as $k => $v) {
                        $merged[$k] = (isset($curWs[$k]) && is_array($curWs[$k]) && is_array($v)) ? ($v + $curWs[$k]) : $v;
                    }
                    $req['ws'] = $merged + $curWs;

                    $rank = ['requested' => 1, 'answered' => 2];
                    $oldStatus = is_array($cur) ? ($cur['status'] ?? '') : '';
                    $newStatus = $req['status'] ?? '';
                    if (($rank[$oldStatus] ?? 0) > ($rank[$newStatus] ?? 0)) {
                        $req['status'] = $oldStatus;
                        foreach (['answeredAt', 'answerComplete', 'manager'] as $f) {
                            if (is_array($cur) && array_key_exists($f, $cur)) {
                                $req[$f] = $cur[$f];
                            }
                        }
                    }

                    $requestModel->update([
                        'no' => (int) $req['no'],
                        'payload' => json_encode($req, JSON_UNESCAPED_UNICODE),
                        'updated_at' => now()->timestamp,
                        'updated_by' => $user->id,
                    ]);
                } finally {
                    DB::statement("SELECT RELEASE_LOCK(?)", ["rc_" . $id]);
                }
            }

            $changed = true;
        }

        if (isset($request->input()['phones']) && is_array($request->input()['phones'])) {
            Meta::updateOrCreate(['key' => 'phones'], ['value' => json_encode($request->input()['phones'], JSON_UNESCAPED_UNICODE)]);
            $changed = true;
        }
        if (isset($request->input()['fullbook']) && is_array($request->input()['fullbook'])) {
            Meta::updateOrCreate(['key' => 'fullbook'], ['value' => json_encode($request->input()['fullbook'], JSON_UNESCAPED_UNICODE)]);
            $changed = true;
        }

        $rev = $changed ? $this->bumpRev() : (int) (Meta::where('key', 'rev')->value('value') ?? 0);

        return response()->json(['ok' => true, 'rev' => $rev, 'fixes' => $fixes]);
    }

    public function delete(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $ids = array_filter(array_map('intval', $request->input('ids') ?? []));
        if ($ids) {
            RequestModel::whereIn('id', $ids)->update([
                'deleted' => 1,
                'updated_at' => now()->timestamp
            ]);
            $this->bumpRev();
        }

        return response()->json(['ok' => true]);
    }

    public function setOffdays(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        $dates = $this->normalizeDates($request->input('dates') ?? []);
        $weekdays = array_map('intval', (array) ($request->input('weekdays') ?? []));
        $workOverrides = $this->normalizeDates($request->input('work_overrides') ?? []);

        $offDays = [
            'dates' => $dates,
            'weekdays' => $weekdays,
            'work_overrides' => $workOverrides,
        ];

        $user->update(['off_days' => json_encode($offDays, JSON_UNESCAPED_UNICODE)]);

        return response()->json(['ok' => true]);
    }

    public function getAgencies(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        return response()->json(['ok' => true, 'agencies' => []]);
    }

    public function getHotels(Request $request)
    {
        $user = $request->user();
        if (!$user || $user->status !== 'approved') {
            return response()->json(['error' => 'pending'], 403);
        }

        return response()->json(['ok' => true, 'hotels' => []]);
    }

    private function getAllRequests($user): array
    {
        $out = [];
        $superEmail = strtolower(env('ADMIN_EMAIL', 'admin@nirvana.local'));
        $isSuperAdmin = $user->role === 'admin' && strtolower($user->email) === $superEmail;
        $userRegion = $user->region;
        $userId = $user->id;
        $userRole = $user->role;

        $query = RequestModel::where('deleted', 0)->get();

        foreach ($query as $r) {
            $payload = json_decode($r->payload, true);
            if (!$payload) continue;

            if ($isSuperAdmin || $userRole === 'agent') {
                $out[] = $payload;
                continue;
            }

            if ($r->created_by > 0 && $r->created_by === $userId) {
                $out[] = $payload;
                continue;
            }

            if (in_array($userRole, ['sreq', 'schk'], true)) {
                $reqRegion = $payload['region'] ?? null;
                if ($userRegion && $reqRegion === $userRegion) {
                    $out[] = $payload;
                }
            }
        }

        return $out;
    }

    private function normalizeDates(array $dates): array
    {
        $out = [];
        foreach ($dates as $d) {
            $d = trim((string)$d);
            if (preg_match('/^\d{4}-\d{2}-\d{2}$/', $d)) {
                $out[$d] = true;
            }
        }
        $out = array_keys($out);
        sort($out);
        return $out;
    }

    private function bumpRev(): int
    {
        $rev = (int) (Meta::where('key', 'rev')->value('value') ?? 0) + 1;
        Meta::updateOrCreate(['key' => 'rev'], ['value' => (string)$rev]);
        return $rev;
    }
}
