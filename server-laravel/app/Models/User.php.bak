<?php
namespace App\Models;
use Illuminate\Database\Eloquent\Model;

class User extends Model {
    public $timestamps = false;
    protected $fillable = ['name', 'email', 'pass_hash', 'role', 'status', 'lang', 'telegram_chat_id', 'tg_link_code', 'notif_read_at', 'agency_idx', 'agency_parent_idx', 'agency_kind', 'agency_login_id', 'phone', 'nickname', 'bank_account', 'orig_role', 'off_days', 'region', 'created_at'];
    protected $casts = ['off_days' => 'json'];
    protected $hidden = ['pass_hash'];
}
